{
  "name": "base-hackathon-stock-properties",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "forge": "node node_modules/@foundry-rs/forge/bin.mjs",
