    "contracts:test": "npm run forge -- test",
    "contracts:abi": "npm run contracts:build && tsx scripts/export-abis.ts",
    "chain": "npm run contracts:build && tsx scripts/chain.ts",
    "deploy": "npm run contracts:build && tsx scripts/deploy.ts",
    "demo:prices": "tsx scripts/demo-prices.ts",
    "demo:reservation": "tsx scripts/demo-reservation.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@base-org/account": "^2.6.0",
    "@privy-io/react-auth": "^3.51.4",
    "@stripe/stripe-js": "^1.54.2",
    "@tanstack/react-query": "^5.107.1",
    "jose": "6.2.17",
    "next": "16.4.6",
    "ox": "^1.8.16",
    "permissionless": "^0.2.57",
    "qrcode.react": "^4.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "viem": "^2.57.19",
    "wagmi": "^3.7.11",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@foundry-rs/anvil": "^1.7.1",
    "@foundry-rs/cast": "^1.7.1",
    "@foundry-rs/forge": "^1.7.1",
    "@openzeppelin/contracts": "^5.6.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "forge-std": "github:foundry-rs/forge-std#v1.9.7",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
